# ============================================================
# JiaAgent 配置文件模板
#
# 用法：把本文件复制一份，改名为 .env，然后填入你自己的 Key。
#      .env 已被 .gitignore 排除，永远不会被提交到 Git。
#
# 只填写你实际要用的那几家即可，其余留空。
# ============================================================

# ---- 模型 API Key ----
JIA_DEEPSEEK_API_KEY=
JIA_GLM_API_KEY=
JIA_QWEN_API_KEY=
JIA_OPENAI_API_KEY=

# ---- 运行参数 ----
# 只监听本机，局域网里其他设备访问不到（安全考虑）
JIA_HOST=127.0.0.1
JIA_PORT=8000
JIA_LOG_LEVEL=INFO

# ---- 真实鼠标输入（默认关闭，强烈建议保持 0）----
# 这是双重启用条件里的第二道，必须和 config/tools.yaml 的
# input.real_mouse_enabled: true 同时满足，真实后端才会被构造。
# 这一项**只从真实的进程环境读取**，不会从 .env 自动加载；
# 需要启用时，请在你启动服务的终端里显式设置 JIA_ENABLE_REAL_MOUSE=1。
# 启用前请确认你真的需要佳操作真实鼠标；点击仍然逐次确认。
JIA_ENABLE_REAL_MOUSE=0
